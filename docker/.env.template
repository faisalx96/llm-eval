# ═══════════════════════════════════════════════════════════════════════
# qym platform — Docker Compose environment template
# ═══════════════════════════════════════════════════════════════════════
#
# Docker Compose v2 loads `.env` from the project directory — the directory
# of the first compose file passed with -f (here: docker/) — while legacy
# v1 read it from the shell's working directory. Copy this template next to
# the compose files and pass --env-file explicitly so both behave the same:
#
#        cp docker/.env.template docker/.env
#
#   1. Run from docker/:
#        cd docker && docker compose up -d
#
#   2. OR run from the repo root:
#        docker compose -f docker/docker-compose.yml --env-file docker/.env up -d
#
# Values below are safe local-dev placeholders. Replace every CHANGE_ME
# before exposing the platform anywhere beyond localhost.

# ───────────────────────────────────────────────────────────────────────
# Postgres (db service)
# ───────────────────────────────────────────────────────────────────────
# Credentials for the bundled postgres:16 container. POSTGRES_PASSWORD is
# required — postgres refuses to start without it.
POSTGRES_USER=qym
POSTGRES_PASSWORD=qym
POSTGRES_DB=qym
# Host port the database is published on (container always listens on 5432).
POSTGRES_PORT=5432

# ───────────────────────────────────────────────────────────────────────
# Platform (api service)
# ───────────────────────────────────────────────────────────────────────
# Deployment environment label: dev | staging | prod. Dev-like values
# (dev, development, test, testing, local) relax startup auth validation;
# anything else REQUIRES a real auth setup (see Authentication below).
QYM_ENVIRONMENT=dev
# Public URL the platform is reachable at (used for links, OAuth redirects).
QYM_BASE_URL=http://localhost:8000
# Mount path when serving behind a reverse-proxy sub-path (usually empty).
QYM_ROOT_PATH=
# Database URL as seen from INSIDE the compose network: host is the `db`
# service on port 5432. Keep user/password/db in sync with POSTGRES_* above.
QYM_DATABASE_URL=postgresql+psycopg2://qym:qym@db:5432/qym
# One-time token used to bootstrap the first admin user/API key.
QYM_ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME_bootstrap_token

# ───────────────────────────────────────────────────────────────────────
# Authentication
# ───────────────────────────────────────────────────────────────────────
# Auth mode: none | proxy_headers | oidc
#   none          DEV ONLY — every anonymous request becomes an admin
#                 principal. Never use outside localhost. Startup fails
#                 unless QYM_ENVIRONMENT is dev-like.
#   proxy_headers Trust identity headers injected by an authenticating
#                 reverse proxy in front of the platform.
#   oidc          Built-in OIDC login (configure provider credentials below).
QYM_AUTH_MODE=none
# Secret used to sign session cookies (any long random string).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
QYM_AUTH_SESSION_SECRET=CHANGE_ME_session_secret
# Enable local email/password login alongside OIDC (true/false).
QYM_AUTH_LOCAL_ENABLED=false
# Shared secret the authenticating reverse proxy must present with the
# identity headers (required when QYM_AUTH_MODE=proxy_headers).
QYM_PROXY_SHARED_SECRET=CHANGE_ME_proxy_shared_secret

# OAuth / OIDC provider credentials (used when QYM_AUTH_MODE=oidc).
# Leave blank to disable a provider.
QYM_AUTH_GOOGLE_CLIENT_ID=
QYM_AUTH_GOOGLE_CLIENT_SECRET=
QYM_AUTH_GITHUB_CLIENT_ID=
QYM_AUTH_GITHUB_CLIENT_SECRET=

# ───────────────────────────────────────────────────────────────────────
# Secrets at rest
# ───────────────────────────────────────────────────────────────────────
# Fernet key used to encrypt stored LLM provider credentials.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QYM_LLM_CONFIG_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# ───────────────────────────────────────────────────────────────────────
# TLS / outbound HTTP (optional — leave blank for system defaults)
# ───────────────────────────────────────────────────────────────────────
# Path to a custom CA bundle for platform-originated HTTPS requests.
QYM_PLATFORM_CA_BUNDLE=
# Set to false to disable TLS verification for platform requests (dev only).
QYM_PLATFORM_SSL_VERIFY=
# SDK-side equivalents (picked up by tools running inside the container).
QYM_CA_BUNDLE=
QYM_SSL_VERIFY=

# ───────────────────────────────────────────────────────────────────────
# Backups (db-backup service)
# ───────────────────────────────────────────────────────────────────────
# Host directory where pg_dump archives are written.
QYM_BACKUP_PATH=./backups
# How many days of backups to retain.
BACKUP_KEEP_DAYS=14
# Hours between backup runs.
BACKUP_INTERVAL_HOURS=24
