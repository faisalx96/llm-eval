# This template has moved to docker/.env.template, which covers every
# variable the Docker Compose stack requires.
#
# Quickstart:
#   cp docker/.env.template docker/.env
#   cd docker && docker compose up -d
# (or run from the repo root with:
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up -d)
#
# For running the SDK / platform directly (no Docker), the commonly needed
# variables are:
#
# SDK → Platform connection
#   QYM_BASE_URL=http://localhost:8000
#   QYM_API_KEY=
#   QYM_PLATFORM_DEBUG=false
#
# Platform server
#   QYM_DATABASE_URL=postgresql+psycopg2://qym:qym@localhost:5432/qym
#   QYM_ADMIN_BOOTSTRAP_TOKEN=
#   QYM_AUTH_MODE=none   # dev only — see docker/.env.template for details
